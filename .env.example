# PostgreSQL（Docker Compose）
POSTGRES_DB=money
POSTGRES_USER=money
POSTGRES_PASSWORD=change-me

# 后端
DATABASE_URL=postgresql+psycopg://money:change-me@db:5432/money
CORS_ORIGINS=http://localhost:3000
IMPORT_SESSION_TTL_MINUTES=30

# 前端
NEXT_PUBLIC_API_URL=http://localhost:8001

# 研究数据仓库
MONEY_RESEARCH_DATA_DIR=/root/Src/money/data/research
MONEY_RESEARCH_DB=/root/Src/money/data/research/research.duckdb
MONEY_RESEARCH_SYNC_BATCH_SIZE=200
