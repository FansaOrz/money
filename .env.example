# PostgreSQL（Docker Compose）
POSTGRES_DB=money
POSTGRES_USER=money
POSTGRES_PASSWORD=change-me

# 后端（Settings 使用 MONEY_ 前缀）
MONEY_DATABASE_URL=postgresql+psycopg://money:change-me@db:5432/money
MONEY_CORS_ORIGINS=http://localhost:3000
MONEY_IMPORT_SESSION_TTL_MINUTES=30

# 前端：浏览器默认使用同源 /api；这里只配置 Next.js 服务端代理目标
NEXT_PUBLIC_API_URL=
API_PROXY_URL=http://127.0.0.1:8001

# 研究数据仓库
MONEY_RESEARCH_DATA_DIR=/data/research
MONEY_RESEARCH_DB=/data/research/research.duckdb
MONEY_RESEARCH_SYNC_BATCH_SIZE=200
